{
  "manifest_version": 3,
  "name": "Spins Logger",
  "version": "2.2.1",
  "description": "Logs spins; optional auto-dozens betting.",
  "permissions": ["storage", "downloads", "scripting", "activeTab"],
  "host_permissions": ["https://play.livetables.io/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://play.livetables.io/*"],
      "js": ["content.js", "bettor.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

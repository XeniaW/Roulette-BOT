{
  "manifest_version": 3,
  "name": "Spins Logger",
  "version": "4.4.6",
  "description": "Logs spins; auto-betting for dozens, rows, combo (dozen+row), sixlines and threes.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://play.livetables.io/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.livetables.io/*"
      ],
      "js": [
        "content.js",
        "auto/engine.js",
        "auto/market-base.js",
        "auto/dozens.js",
        "auto/rows.js",
        "auto/combo.js",
        "auto/sixlines.js",
        "auto/threes.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
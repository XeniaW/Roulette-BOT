{
  "manifest_version": 3,
  "name": "Spins Logger",
  "version": "4.16.8",
  "description": "Logs spins; auto-betting for dozens, rows, combo (dozen+row), sixlines and threes.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://play.livetables.io/*"
      ],
      "js": [
        "content.js",
        "auto/engine.js",
        "auto/market-base.js",
        "auto/dozens.js",
        "auto/rows.js",
        "auto/combo.js",
        "auto/sixlines.js",
        "auto/threes.js",
        "auto/colors.js",
        "auto/evenodd.js",
        "auto/lowhigh.js",
        "auto/sectors.js",
        "auto/neighbors.js",
        "auto/anti-dozens.js",
        "auto/anti-rows.js",
        "auto/numbers.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}